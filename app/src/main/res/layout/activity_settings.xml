<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:filterTouchesWhenObscured="true">

    <!-- Header -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@color/bg_card"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Close"
        android:padding="10dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btn_close" />

    <!-- VirusTotal Key Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_vt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="28dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/btn_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦠  VirusTotal API Key"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/et_vt_key"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Paste your 64-char API key"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@color/bg_dark"
                android:paddingHorizontal="12dp"
                android:inputType="textPassword"
                android:textSize="13sp"
                android:maxLines="1" />

            <Button
                android:id="@+id/btn_save_vt"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Save Key"
                android:background="@drawable/btn_blue_bg"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:stateListAnimator="@null"
                android:elevation="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Encrypted locally. Only sent to VirusTotal over HTTPS."
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SHA-1 Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_sha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/card_vt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑  Google Sign-In Setup"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_sha1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App SHA-1: loading…"
                android:textSize="11sp"
                android:textColor="@color/accent_blue"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add this SHA-1 to Google Cloud Console → OAuth 2.0 Client ID (Android type) to fix sign-in."
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Root Warning -->
    <TextView
        android:id="@+id/tv_root_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/root_warning"
        android:textColor="@color/threat_high"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"
        android:padding="10dp"
        android:background="@color/bg_card"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/card_sha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
