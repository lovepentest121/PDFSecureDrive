<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF080C14"
    android:filterTouchesWhenObscured="true">

    <!-- ══════ TOP BAR ══════ -->
    <LinearLayout
        android:id="@+id/ll_topbar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/video_topbar_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back arrow -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_logout"
            android:background="@drawable/chip_bg"
            android:padding="8dp"
            android:contentDescription="Back"
            android:rotation="180"
            android:layout_marginEnd="12dp" />

        <!-- Icon + title -->
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="🎬"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/badge_downloaded"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video Vault"
                android:textColor="#FFE2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOWNLOADER"
                android:textColor="#FF7C3AED"
                android:textSize="8sp"
                android:letterSpacing="0.15" />
        </LinearLayout>

        <!-- Download count badge -->
        <LinearLayout
            android:id="@+id/ll_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@drawable/badge_downloaded">
            <TextView
                android:id="@+id/tv_download_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFa78bfa"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" SAVED"
                android:textColor="#4Da78bfa"
                android:textSize="9sp"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════ DOWNLOADER CARD ══════ -->
    <LinearLayout
        android:id="@+id/ll_downloader_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/video_card_bg"
        android:padding="16dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:elevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/ll_topbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Platform icons row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶️  📸  🐦  👥  💼  🎵"
            android:textSize="18sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp" />

        <!-- URL input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/search_bg"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/et_video_url"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Paste YouTube, Instagram, TikTok link…"
                android:textColorHint="#FF334155"
                android:textColor="#FFE2E8F0"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true" />

            <Button
                android:id="@+id/btn_paste_url"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Paste"
                android:background="@drawable/chip_bg"
                android:textColor="#FF94A3B8"
                android:textSize="10sp"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="4dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Download button -->
        <Button
            android:id="@+id/btn_video_download"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="⬇️  Detect &amp; Download"
            android:background="@drawable/btn_video_primary"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- ══════ HISTORY HEADER + SEARCH ══════ -->
    <LinearLayout
        android:id="@+id/ll_history_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/ll_downloader_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="4dp"
                android:layout_height="16dp"
                android:background="#FF7C3AED"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VIDEO LEDGER"
                android:textColor="#FFE2E8F0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_saved_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 SAVED"
                android:textColor="#FFa78bfa"
                android:textSize="9sp"
                android:background="@drawable/badge_downloaded"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Search bar -->
        <LinearLayout
            android:id="@+id/ll_search"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/search_bg"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="8dp"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search by title or platform…"
                android:textColorHint="#FF334155"
                android:textColor="#FFE2E8F0"
                android:textSize="12sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════ HISTORY LIST ══════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_videos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_animation_fall_down"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_history_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════ EMPTY STATE ══════ -->
    <LinearLayout
        android:id="@+id/ll_empty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ll_history_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬"
            android:textSize="56sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No downloads yet"
            android:textColor="#FFE2E8F0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paste a YouTube, Instagram or TikTok\nlink above and tap ⬇️ to start"
            android:textColor="#FF64748B"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
