<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:filterTouchesWhenObscured="true">

    <!-- Settings button top-right -->
    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@color/bg_card"
        android:src="@drawable/ic_settings"
        android:contentDescription="Settings"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp" />

    <!-- App title top-left -->
    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="PDF Secure Drive"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="28dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_settings" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Scan · Protect · Upload"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_app_title"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Guideline for vertical centering -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_v_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.48" />

    <!-- Main Status Card (3D) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:layout_constraintTop_toTopOf="@id/guide_v_center"
        app:layout_constraintBottom_toBottomOf="@id/guide_v_center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp">

            <TextView
                android:id="@+id/tv_shield_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to start monitoring"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.5" />

            <!-- Sign In Button -->
            <Button
                android:id="@+id/btn_sign_in"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Connect Google Drive"
                android:background="@drawable/btn_blue_bg"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="28dp"
                android:layout_marginTop="20dp"
                android:stateListAnimator="@null"
                android:elevation="6dp" />

            <!-- Sign Out Button -->
            <Button
                android:id="@+id/btn_sign_out"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Disconnect"
                android:background="@color/bg_dark"
                android:textColor="@color/error_red"
                android:textSize="13sp"
                android:paddingHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Root Warning -->
    <TextView
        android:id="@+id/tv_root_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/root_warning"
        android:textColor="@color/threat_high"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"
        android:padding="10dp"
        android:background="@color/bg_card"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/card_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom feature row (3 chips) -->
    <LinearLayout
        android:id="@+id/ll_features"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍 Scan"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:chipBackgroundColor="@color/bg_card"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="@color/divider"
            android:layout_marginHorizontal="4dp"
            android:clickable="false" />

        <com.google.android.material.chip.Chip
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="☁️ Upload"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:chipBackgroundColor="@color/bg_card"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="@color/divider"
            android:layout_marginHorizontal="4dp"
            android:clickable="false" />

        <com.google.android.material.chip.Chip
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ Block"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:chipBackgroundColor="@color/bg_card"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="@color/divider"
            android:layout_marginHorizontal="4dp"
            android:clickable="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
