<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF080C14"
    android:filterTouchesWhenObscured="true">

    <!-- ══════ TOP BAR ══════ -->
    <LinearLayout
        android:id="@+id/ll_topbar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/topbar_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="P"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/btn_primary"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF Secure Drive"
                android:textColor="#FFE2E8F0"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURITY CORE"
                android:textColor="#FF3B82F6"
                android:textSize="8sp"
                android:letterSpacing="0.15" />
        </LinearLayout>

        <!-- Interceptor pill -->
        <LinearLayout
            android:id="@+id/ll_interceptor"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@drawable/chip_bg"
            android:layout_marginEnd="8dp">
            <View
                android:id="@+id/v_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_green"
                android:layout_marginEnd="5dp"
                android:visibility="invisible"/>
            <TextView
                android:id="@+id/tv_interceptor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE"
                android:textColor="#FF64748B"
                android:textSize="8sp"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- Video Vault shortcut -->
        <Button
            android:id="@+id/btn_video_section"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="🎬"
            android:background="@drawable/badge_downloaded"
            android:textColor="#FFa78bfa"
            android:textSize="14sp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_settings"
            android:background="@drawable/chip_bg"
            android:padding="6dp"
            android:contentDescription="Settings"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btn_logout"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_logout"
            android:background="@drawable/chip_bg"
            android:padding="6dp"
            android:contentDescription="Logout"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Connect"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:paddingHorizontal="12dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- ══════ PERMISSION BANNER ══════ -->
    <LinearLayout
        android:id="@+id/ll_permission_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/permission_banner_bg"
        android:padding="12dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_topbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠️  Allow 'All Files Access' for full PDF detection"
            android:textColor="#FFFF9500"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_grant_permission"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Grant"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:paddingHorizontal="12dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- ══════ STATS ROW ══════ -->
    <LinearLayout
        android:id="@+id/ll_stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/ll_permission_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Drive card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/stat_card_blue"
            android:padding="14dp"
            android:layout_marginEnd="6dp"
            android:elevation="8dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="☁️" android:textSize="14sp" android:layout_marginEnd="5dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="CLOUD DRIVE" android:textColor="#FF3B82F6" android:textSize="9sp"
                    android:textStyle="bold" android:letterSpacing="0.12" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom" android:layout_marginBottom="2dp">
                <TextView android:id="@+id/tv_drive_used"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="#FFF1F5F9"
                    android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" GB" android:textColor="#FF64748B"
                    android:textSize="12sp" android:layout_marginBottom="4dp" />
            </LinearLayout>

            <TextView android:id="@+id/tv_drive_quota"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Connect to see usage" android:textColor="#FF2D4A7A"
                android:textSize="9sp" android:layout_marginBottom="10dp" android:layout_marginTop="1dp" />

            <ProgressBar android:id="@+id/pb_drive"
                android:layout_width="match_parent" android:layout_height="4dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progress="0" android:progressTint="#FF3B82F6"
                android:progressBackgroundTint="#FF0D1E3D" />
        </LinearLayout>

        <!-- Analytics card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/stat_card_green"
            android:padding="14dp"
            android:layout_marginStart="6dp"
            android:elevation="8dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🛡️" android:textSize="14sp" android:layout_marginEnd="5dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="ANALYTICS" android:textColor="#FF10B981" android:textSize="9sp"
                    android:textStyle="bold" android:letterSpacing="0.12" />
            </LinearLayout>

            <!-- Scans stat -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/stat_inner_bg" android:padding="8dp"
                android:layout_marginBottom="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="SCANS" android:textColor="#FF475569" android:textSize="9sp"
                    android:textStyle="bold" android:letterSpacing="0.08" />
                <TextView android:id="@+id/tv_intercepts"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="#FF60A5FA"
                    android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Secured stat -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/stat_inner_bg" android:padding="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="SECURED" android:textColor="#FF475569" android:textSize="9sp"
                    android:textStyle="bold" android:letterSpacing="0.08" />
                <TextView android:id="@+id/tv_secured"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="#FF34D399"
                    android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ══════ HISTORY HEADER + SEARCH ══════ -->
    <LinearLayout
        android:id="@+id/ll_history_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/ll_stats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <View android:layout_width="4dp" android:layout_height="16dp"
                android:background="#FF3B82F6" android:layout_marginEnd="8dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="PDF LEDGER" android:textColor="#FFE2E8F0"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" />
            <TextView android:id="@+id/tv_secured_badge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 SECURED" android:textColor="#FF10B981" android:textSize="9sp"
                android:background="@drawable/badge_uploaded"
                android:paddingHorizontal="8dp" android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Search bar (always visible when header is visible) -->
        <LinearLayout
            android:id="@+id/ll_search"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/search_bg"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="8dp"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search by title, filename…"
                android:textColorHint="#FF334155"
                android:textColor="#FFE2E8F0"
                android:textSize="12sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>


    <!-- ══════ LIST ══════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_history"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_history_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════ EMPTY STATE ══════ -->
    <LinearLayout
        android:id="@+id/ll_empty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ll_history_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛡️" android:textSize="52sp" />
        <TextView android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="No scans yet" android:textColor="#FFE2E8F0"
            android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="12dp" />
        <TextView android:id="@+id/tv_empty_sub"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Connect Drive, then download any PDF\nto start automatic scanning"
            android:textColor="#FF64748B" android:textSize="12sp" android:gravity="center"
            android:lineSpacingMultiplier="1.5" android:layout_marginTop="8dp" />
        <Button android:id="@+id/btn_sign_in_empty"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="Connect Google Drive"
            android:background="@drawable/btn_primary" android:textColor="#FFFFFFFF"
            android:textSize="13sp" android:paddingHorizontal="24dp"
            android:layout_marginTop="20dp" android:stateListAnimator="@null"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_root_warning"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="@string/root_warning" android:textColor="#FFFF6D00"
        android:textSize="11sp" android:gravity="center" android:visibility="gone"
        android:padding="8dp" android:background="#1AFF6D00"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
