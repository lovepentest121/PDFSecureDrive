<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF080C14"
    android:filterTouchesWhenObscured="true">

    <!-- Top bar -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="PDF Secure Drive"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFE8EDF3"
        android:letterSpacing="0.04"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_settings" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/chip_bg"
        android:src="@drawable/ic_settings"
        android:contentDescription="Settings"
        android:padding="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shield + Pulse section -->
    <FrameLayout
        android:id="@+id/fl_shield"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="36dp"
        app:layout_constraintTop_toBottomOf="@id/tv_app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Pulse ring (animated when active) -->
        <View
            android:id="@+id/v_pulse"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_pulse"
            android:alpha="0" />

        <!-- Shield icon -->
        <TextView
            android:id="@+id/tv_shield"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🛡️"
            android:textSize="64sp" />
    </FrameLayout>

    <!-- Status dot + label -->
    <LinearLayout
        android:id="@+id/ll_status_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/fl_shield"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/v_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_green"
            android:visibility="invisible"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tv_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INACTIVE"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:textColor="#FF6B7A99" />
    </LinearLayout>

    <!-- Main Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="20dp"
        app:cardBackgroundColor="#00000000"
        app:layout_constraintTop_toBottomOf="@id/ll_status_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/ll_card_inner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_glow_idle"
            android:padding="28dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect Google Drive to start\nautomatically scanning all PDF downloads"
                android:textSize="14sp"
                android:textColor="#FFB0BBCC"
                android:gravity="center"
                android:lineSpacingMultiplier="1.6" />

            <Button
                android:id="@+id/btn_sign_in"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Connect Google Drive"
                android:background="@drawable/btn_primary"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:paddingHorizontal="32dp"
                android:layout_marginTop="20dp"
                android:stateListAnimator="@null"
                android:elevation="8dp" />

            <Button
                android:id="@+id/btn_sign_out"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Disconnect"
                android:background="@android:color/transparent"
                android:textColor="#FFCF6679"
                android:textSize="13sp"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Root Warning -->
    <TextView
        android:id="@+id/tv_root_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/root_warning"
        android:textColor="#FFFF6D00"
        android:textSize="11sp"
        android:gravity="center"
        android:visibility="gone"
        android:padding="10dp"
        android:background="#1AFF6D00"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/card_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom feature chips -->
    <LinearLayout
        android:id="@+id/ll_chips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="🔍 Scan"
            android:textColor="#FF6B8EBF"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:layout_marginHorizontal="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="🛡️ Block"
            android:textColor="#FF6B8EBF"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:layout_marginHorizontal="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="☁️ Upload"
            android:textColor="#FF6B8EBF"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:layout_marginHorizontal="4dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
