<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/stat_card_blue"
    android:padding="24dp">

    <!-- Header row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🎬" android:textSize="28sp" android:layout_marginEnd="10dp" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="VIDEO DETECTED" android:textColor="#FF3B82F6"
                android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.12" />
            <TextView android:id="@+id/tv_platform"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="▶️ YouTube" android:textColor="#FFF1F5F9"
                android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/btn_close"
            android:layout_width="32dp" android:layout_height="32dp"
            android:text="✕" android:textColor="#FF64748B" android:textSize="16sp"
            android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="@drawable/chip_bg" />
    </LinearLayout>

    <!-- URL chip -->
    <TextView android:id="@+id/tv_video_url"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="https://youtube.com/..."
        android:textColor="#FF475569" android:textSize="9sp"
        android:background="@drawable/chip_bg"
        android:paddingHorizontal="10dp" android:paddingVertical="6dp"
        android:layout_marginBottom="14dp"
        android:maxLines="1" android:ellipsize="middle" />

    <!-- Loading bar -->
    <ProgressBar android:id="@+id/pb_fetch"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:indeterminateTint="#FF3B82F6"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Video title -->
    <TextView android:id="@+id/tv_video_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Fetching title…"
        android:textColor="#FFF1F5F9" android:textSize="14sp" android:textStyle="bold"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="20dp"
        android:maxLines="3" android:ellipsize="end" />

    <!-- Primary action button -->
    <Button android:id="@+id/btn_download"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="⬇️ Download Video"
        android:background="@drawable/btn_primary"
        android:textColor="#FFFFFFFF" android:textSize="13sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        android:layout_marginBottom="8dp"
        android:enabled="false" />

    <!-- Copy title (shown once the title is fetched) -->
    <Button android:id="@+id/btn_copy_title"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:text="📋 Copy Title"
        android:background="@drawable/chip_bg"
        android:textColor="#FF3B82F6" android:textSize="12sp"
        android:stateListAnimator="@null"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Open in browser -->
    <Button android:id="@+id/btn_open_browser"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:text="🌐 Open in Browser"
        android:background="@drawable/chip_bg"
        android:textColor="#FF94A3B8" android:textSize="12sp"
        android:stateListAnimator="@null" />

</LinearLayout>
