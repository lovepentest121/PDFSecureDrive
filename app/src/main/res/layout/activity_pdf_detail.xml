<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0F1E"
    android:filterTouchesWhenObscured="true">

    <!-- Close button -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="@drawable/chip_bg"
        android:padding="8dp"
        android:contentDescription="Close"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="PDF Detail"
        android:textColor="#FFE2E8F0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/btn_close"
        app:layout_constraintBottom_toBottomOf="@id/btn_close"
        app:layout_constraintStart_toEndOf="@id/btn_close"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cover image -->
    <ImageView
        android:id="@+id/iv_cover"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:background="#FF0F1629"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- No cover placeholder -->
    <TextView
        android:id="@+id/tv_no_cover"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:text="📄"
        android:textSize="64sp"
        android:gravity="center"
        android:background="#FF0F1629"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status badge on cover -->
    <TextView
        android:id="@+id/tv_detail_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UPLOADED"
        android:textColor="#FF10B981"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/badge_uploaded"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="@id/iv_cover"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Info card -->
    <LinearLayout
        android:id="@+id/ll_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="18dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/iv_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- AI Title -->
        <TextView
            android:id="@+id/tv_ai_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Document Title"
            android:textColor="#FFE2E8F0"
            android:textSize="17sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="10dp" />

        <!-- File details row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SIZE" android:textColor="#FF64748B" android:textSize="10sp" android:letterSpacing="0.08" />
            <TextView android:id="@+id/tv_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFB0BBCC" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DATE" android:textColor="#FF64748B" android:textSize="10sp" android:letterSpacing="0.08" />
            <TextView android:id="@+id/tv_detail_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFB0BBCC" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SHA-256" android:textColor="#FF64748B" android:textSize="10sp" android:letterSpacing="0.08" />
            <TextView android:id="@+id/tv_hash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFB0BBCC" android:textSize="10sp" android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:id="@+id/ll_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/ll_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_open_drive"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Open in Drive"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:stateListAnimator="@null"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_copy_link"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Copy Link"
            android:background="@drawable/panel_bg"
            android:textColor="#FF3B82F6"
            android:textSize="13sp"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Save cover button -->
    <Button
        android:id="@+id/btn_save_cover"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:text="Save Cover to Gallery"
        android:background="@android:color/transparent"
        android:textColor="#FF64748B"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="16dp"
        android:stateListAnimator="@null"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
