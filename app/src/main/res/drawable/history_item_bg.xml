<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_accent">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#1A3B82F6" />
                    <stroke android:width="1dp" android:color="#403B82F6" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="135"
                        android:startColor="#FF0F1629"
                        android:endColor="#FF0A0F1E" />
                    <stroke android:width="1dp" android:color="#FF1A2540" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
