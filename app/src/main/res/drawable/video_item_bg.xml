<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#337C3AED">
    <item>
        <layer-list>
            <!-- Subtle bottom shadow for 3D depth -->
            <item android:top="3dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1A7C3AED"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <!-- Main card surface -->
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF111827"/>
                    <stroke android:width="1dp" android:color="#267C3AED"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
